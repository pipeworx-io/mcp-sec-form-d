      "type": "object",
      "properties": {
        "cik": {
          "type": "string",
          "description": "Issuer CIK, with or without leading zeros."
        },
        "limit": {
          "type": "number",
          "description": "Filings to hydrate (1-20, default 10)."
        }
      },
      "required": [
        "cik"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "returned": {
          "type": "number"
        },
        "filings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "accession_number": {
                "type": "string"
              },
              "cik": {
                "type": "string"
              },
              "issuer_name": {
                "type": "string"
              },
              "filing_date": {
                "type": "string"
              },
              "is_amendment": {
                "type": "boolean"
              },
              "total_offering_amount": {
                "type": "number"
              },
              "total_amount_sold": {
                "type": "number"
              },
              "total_remaining": {
                "type": "number"
              },
              "filing_url": {
                "type": "string"
              }
